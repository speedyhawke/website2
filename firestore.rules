rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public visits logging & stats
    match /visits/{visitId} {
      allow read, write: if true;
    }

    // Community Survey Submissions
    match /community_surveys/{surveyId} {
      allow read, write: if true;
    }

    // Professional & Frontline Survey Submissions
    match /professional_surveys/{surveyId} {
      allow read, write: if true;
    }

    // Contact form submissions
    match /contact_messages/{messageId} {
      allow read, write: if true;
    }

    // Donations records
    match /donations/{donationId} {
      allow read, write: if true;
    }

    // Global site settings & aggregations
    match /site_stats/{statId} {
      allow read, write: if true;
    }
  }
}
